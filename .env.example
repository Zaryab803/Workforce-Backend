NODE_ENV=development
PORT=4000

# ==============================================================================
# Database Connection (Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI)
# ==============================================================================
# Session / Pooler URL (for DATABASE_URL):
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?schema=workforce
# Direct URL (for DIRECT_URL migrations):
DIRECT_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?schema=workforce

# ==============================================================================
# Auth & Security
# ==============================================================================
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-before-running
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=orbit-api
JWT_AUDIENCE=orbit-web
REFRESH_TOKEN_DAYS=7
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:3000
# Comma-separated exact origins; no wildcards.
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=0
BCRYPT_ROUNDS=12
LOG_LEVEL=info
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=15
OVERDUE_CRON=0 8 * * *
JOB_TIMEZONE=Asia/Karachi
SEED_PASSWORD=ChangeThisDemo123!

# Email: disabled until you enter real credentials and set EMAIL_ENABLED=true.
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# false + port 587 uses required STARTTLS; true + port 465 uses immediate TLS.
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password-or-app-password
# Use a plain, provider-verified sender address.
EMAIL_FROM=notifications@example.com

# OneSignal: use an app configured for Web Push, not an organization API key.
ONESIGNAL_ENABLED=false
ONESIGNAL_APP_ID=edd7b5b3-0d24-4927-9025-d360f655514e
ONESIGNAL_REST_API_KEY=
# Generate a separate random secret (32+ characters); keep stable across API/workers.
ONESIGNAL_ID_SECRET=replace-with-separate-random-secret
# Durable email/push/live outbox polling interval. API and worker must both run.
OUTBOX_INTERVAL_MS=2000
